<Project Sdk="Microsoft.NET.Sdk">
  <!-- A fancyauth plugin: `dotnet publish` puts it and its own dependencies (ImageSharp) into the output, for fancyauth's
       plugins folder. Keys come from the environment: MAGICLINK_YOUTUBE_API_KEY, MAGICLINK_IMGUR_CLIENT_ID. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>2.0.0</Version>
    <!-- The fancyauth API packages are built for .NET Framework 4.5; only their types are used. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- fancyauth itself provides these: a second copy in the plugins folder would clash with its own. -->
    <PackageReference Include="Fancyauth.API" Version="1.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Fancyauth.APIUtil" Version="1.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" ExcludeAssets="runtime" />
    <!-- Its build checks for a license: sixlabors.lic next to this file, a Six Labors community license for this
         assembly name, meant to be committed. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Handlers\RedditMessage.html" />
    <EmbeddedResource Include="Handlers\YoutubeMessage.html" />
  </ItemGroup>
</Project>
