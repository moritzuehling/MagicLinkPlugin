<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prints what the plugin would send for each URL given as an argument, e.g. with dotnet run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MagicLinkPlugin\MagicLinkPlugin.csproj" />
    <!-- In fancyauth, the host provides it. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
